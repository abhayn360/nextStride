# ---------------------------------------------------------------------------
# NEXT STRIDE API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Host to bind. 0.0.0.0 lets a phone on the same Wi-Fi reach the dev server.
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_stride
# Used by the test suite (`npm test`). Must be a separate, disposable database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_stride_test

# JWT signing secret for access tokens — at least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime in seconds (default 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30
# Password reset link lifetime in minutes (default 30)
PASSWORD_RESET_TTL_MINUTES=30

# Comma separated list of allowed browser origins. Native apps send no Origin
# header and are unaffected. Leave empty to block all cross-origin browsers.
CORS_ORIGINS=http://localhost:8081

# Auth rate limit: max requests per window per IP on login/register/forgot-password
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Public base URL of this API, used to build avatar URLs. Leave empty to derive it from each request.
PUBLIC_BASE_URL=
# Deep link used in password reset emails. The token is appended as ?token=...
PASSWORD_RESET_URL=nextstride://reset-password

# Set to 1 behind a reverse proxy / load balancer so client IPs are correct for rate limiting.
TRUST_PROXY=0

LOG_LEVEL=info
