{
  "expo": {
    "name": "NEXT STRIDE",
    "slug": "next-stride",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nextstride",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111820",
    "ios": {
      "bundleIdentifier": "com.nextstride.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nextstride.app",
      "adaptiveIcon": {
        "backgroundColor": "#111820",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111820",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#111820",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NEXT STRIDE uses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NEXT STRIDE uses your location to record the route, distance and pace of your runs, including while your screen is locked during a run.",
          "locationAlwaysAndWhenInUsePermission": "NEXT STRIDE uses your location to record the route, distance and pace of your runs, including while your screen is locked during a run.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
