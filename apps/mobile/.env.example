# Copy to .env (or .env.local). Values prefixed EXPO_PUBLIC_ are bundled into the app —
# never put secrets here.

# API base URL. Leave unset in development: the app uses the machine running Metro
# on port 4000 (works on simulators and on a phone on the same Wi-Fi).
# Required for production builds.
# EXPO_PUBLIC_API_URL=https://api.nextstride.app

# Map tiles (MapLibre style JSON URLs). Defaults: OpenFreeMap "dark" / "positron"
# (OpenStreetMap data, no key) — fine for development. Check your provider's terms
# before production; free tile services don't promise unlimited commercial traffic.
# EXPO_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# EXPO_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
